{
  "name": "xpoker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:certification": "node --test --test-concurrency=1 server/beta-acceptance.integration.test.js server/full-gameplay.integration.test.js server/chaos-certification.integration.test.js server/resilience-certification.integration.test.js server/soak-certification.integration.test.js server/safe-beta-dealer.test.js server/realtime.test.js server/table-coordinator.test.js",
    "test:soak": "node --test --test-concurrency=1 server/soak-certification.integration.test.js",
    "test:beacon": "node server/beacon-smoke.js",
    "test:poker": "node --test server/poker/*.test.js",
    "test:settlement": "node --test server/settlement/*.test.js",
    "test:contract": "cargo test --manifest-path settlement/Cargo.toml --workspace",
    "build:contract": "cd settlement && anchor build --ignore-keys",
    "smoke:contract-runtime": "cd settlement && node runtime-smoke.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "release:generate": "node server/release-manifest-cli.js generate",
    "release:verify": "node server/release-manifest-cli.js verify",
    "certify:production": "node server/production-certification.js",
    "fairness:demo": "node fairness/demo.js",
    "migrate": "node server/migrate.js",
    "verify:restore": "node server/restore-verify.js",
    "start": "node server/http.js"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "drand-client": "1.4.2",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "ws": "8.21.3"
  }
}
