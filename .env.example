NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://localhost:4173
ALLOWED_ORIGINS=http://localhost:4173
SAFE_BETA_MODE=enabled
# Optional closed-beta gate. Enable only after at least one admin wallet is configured
# and an access code has been created from the Pit Board.
BETA_INVITE_REQUIRED=disabled
# Comma-separated Solana public wallet addresses. Never place seed phrases or private keys here.
ADMIN_WALLETS=
# Required when SAFE_BETA_MODE=enabled in production. Store as a secret.
SAFE_BETA_SIGNING_KEY_PEM=
# Privy App ID is public. PRIVY_APP_SECRET is backend-only and must be sealed.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Real-value mode stays disabled unless every release gate has valid evidence.
REAL_VALUE_MODE=disabled
DATABASE_URL=postgresql://xpoker:xpoker@localhost:5432/xpoker?sslmode=require&uselibpqcompat=true
REDIS_URL=rediss://localhost:6379
# Use `tls` with rediss://. Railway private hostnames may instead use the
# provider's encrypted WireGuard network with an explicit deployment attestation.
REDIS_TRANSPORT_SECURITY=tls
# Apply db/*.sql with `npm run migrate` before starting the authoritative service.
DEALER_KEY_PROVIDER=aws-kms
DEALER_KEY_REFERENCE=
DEALER_SIGNER_URL=
DEALER_SIGNER_TOKEN=
SOLANA_RPC_URL=https://replace-with-dedicated-rpc.example
# Read-only mainnet lookup for the connected wallet's allowlisted xStocks.
# It never submits transactions and may use Solana's public RPC for a small beta.
SOLANA_READ_RPC_URL=https://api.mainnet-beta.solana.com
# The checked-in contract is for local/devnet testing only. Mainnet remains release-gated.
SETTLEMENT_CLUSTER=devnet
SETTLEMENT_PROGRAM_ID=14dia6Spfd6qu6Q36caisExYQsLA9si4PqFpqfiQ8Z9S
SETTLEMENT_PROGRAM_BINARY_SHA256=
SETTLEMENT_UPGRADE_AUTHORITY=
XSTOCKS_API_BASE=https://api.xstocks.fi/api/v2
XSTOCKS_API_KEY=
GEOFENCING_PROVIDER=
IDENTITY_PROVIDER=
MONITORING_DSN=
EXTERNAL_UPTIME_PROVIDER=
EXTERNAL_UPTIME_URL=
# Optional generic HTTPS alert receiver. The token must be a sealed secret.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
# Enables the protected Prometheus-compatible GET /metrics endpoint.
METRICS_BEARER_TOKEN=
MONITOR_INTERVAL_MS=15000
MONITOR_PROBE_TIMEOUT_MS=2000
ALERT_COOLDOWN_MS=300000
MONITOR_OVERDUE_GRACE_MS=30000
MONITOR_STALLED_TABLE_MS=120000
MONITOR_STALLED_BEACON_MS=60000
MONITOR_APPLICATION_INCIDENT_WINDOW_MS=600000
MONITOR_DATABASE_LATENCY_MS=1000
MONITOR_REDIS_LATENCY_MS=500
MONITOR_POOL_WAITING_LIMIT=10
MONITOR_MINIMUM_REQUESTS=20
MONITOR_HTTP_ERROR_RATE_BPS=500
MONITOR_REALTIME_DISCONNECT_RATE_BPS=5000
ASSET_ALLOWLIST_VERSION=launch-allowlist-v1
BUILD_COMMIT=0000000000000000000000000000000000000000
RELEASE_MANIFEST_PATH=production/release-manifest.json
RELEASE_AUTHORITY_PUBLIC_KEY_PEM=
